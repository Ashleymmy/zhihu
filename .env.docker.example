# Compose
ENV_FILE=.env
IMAGE_TAG=latest
WEB_PORT=80
TZ=Asia/Shanghai

# MySQL（生产环境请使用随机值，不要暴露 3306 端口）
MYSQL_DATABASE=zhihu_koc
MYSQL_USER=zhihu
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis（建议使用 openssl rand -hex 24 生成）
REDIS_PASSWORD=

# BFF 安全配置
JWT_SECRET=
JWT_EXPIRES_IN=8h
CALLBACK_SECRET_ENCRYPTION_KEY=

# 知乎 OpenAPI（仅在运行时注入，严禁写入镜像或提交 Git）
ZHIHU_ACCESS_TOKEN=
ZHIHU_SECRET_KEY=
ZHIHU_API_BASE=https://open.zhihu.com

# 联盟 API 配额策略（生产必填，JSON 一行；costs 键固定为 8 个代理端点）
ALLIANCE_QUOTA_POLICY={"dailyBudget":1000,"costs":{"POST /popularize_plan":1,"POST /popularize_plans":1,"POST /popularize_composition/v2":1,"POST /popularize_compositions/v2":1,"PUT /popularize_composition/v2/{composition_id}":1,"GET /popularize_compositions":1,"GET /data_report/real_time_data":1,"GET /data_report/daily_data":1}}

# Grafana 监控面板
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# 资金链 Gate（生产提现开关，四项全开才放行；默认留空 = 关闭）
# FINANCE_GATES_PASSED=D-001-DECISION,D-001-READINESS,P0-008,M6

# 首次部署的管理员账号（仅在数据库为空时创建；首登后请改密）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=系统管理员

# 知乎任务/渠道 ID 无需配置：bootstrap 首启会自动同步全量目录
# 若需手动补拉：登录后在「推广计划 → 同步渠道/任务」或「系统工具 → 数据处理」触发
