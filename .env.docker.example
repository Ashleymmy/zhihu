# Compose
ENV_FILE=.env.docker
IMAGE_TAG=latest
WEB_PORT=80
TZ=Asia/Shanghai

# MySQL（生产环境请使用随机值，不要暴露 3306 端口）
MYSQL_DATABASE=zhihu_koc
MYSQL_USER=zhihu
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis（建议使用 openssl rand -hex 24 生成）
REDIS_PASSWORD=

# BFF 安全配置
JWT_SECRET=
JWT_EXPIRES_IN=8h
CALLBACK_SECRET_ENCRYPTION_KEY=

# 知乎 OpenAPI（仅在运行时注入，严禁写入镜像或提交 Git）
ZHIHU_ACCESS_TOKEN=
ZHIHU_SECRET_KEY=
ZHIHU_API_BASE=https://open.zhihu.com
