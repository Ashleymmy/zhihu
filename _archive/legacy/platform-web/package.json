{
  "name": "opc-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc && vite build",
    "test": "tsc src/utils/compositionFeedback.ts src/utils/compositionList.ts --outDir node_modules/.tmp/composition-feedback-tests --module ES2022 --target ES2022 --moduleResolution Bundler --skipLibCheck && node --test tests/compositionFeedback.test.mjs tests/compositionList.test.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "preview": "vite preview",
    "mock": "node mock-server.cjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.3",
    "axios": "^1.6.8",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.0.6"
  }
}
