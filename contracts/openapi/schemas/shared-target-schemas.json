{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhihu.local/contracts/a001/shared-target-schemas.json",
  "title": "A-001 reusable target schemas",
  "x-a001-state": "target-reusable/not-operation-bound",
  "$defs": {
    "ApiEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string"
        },
        "data": {},
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["code", "message", "data", "requestId", "timestamp"]
    },
    "PaginationMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["page", "pageSize", "total"]
    },
    "PageResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": 0
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "array"
        },
        "meta": {
          "$ref": "#/$defs/PaginationMeta"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["code", "message", "data", "meta", "requestId", "timestamp"]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["code", "message", "requestId", "timestamp"]
    },
    "FinanceGateRejectedErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": 50310
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "failedGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["D-001-DECISION", "D-001-READINESS", "P0-008", "M6"]
          },
          "x-a001-order": ["D-001-DECISION", "D-001-READINESS", "P0-008", "M6"]
        }
      },
      "required": ["code", "message", "requestId", "timestamp", "failedGates"]
    },
    "GlobalRole": {
      "type": "string",
      "enum": ["admin", "leader", "creator"]
    },
    "ProjectMemberRole": {
      "type": "string",
      "enum": ["owner", "admin", "member", "viewer"]
    },
    "AuthorizationHeader": {
      "type": "string",
      "pattern": "^Bearer\\s+\\S+$"
    },
    "RefreshCookieAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "refreshToken"
        },
        "secure": {
          "const": true
        },
        "httpOnly": {
          "const": true
        },
        "sameSite": {
          "const": "Lax"
        },
        "path": {
          "const": "/api/v1/auth"
        }
      },
      "required": ["name", "secure", "httpOnly", "sameSite", "path"]
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "ErrorBaselineStage": {
      "type": "string",
      "enum": [
        "parser",
        "auth",
        "scope",
        "permission",
        "quota",
        "upstream",
        "internal"
      ]
    },
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["user", "system", "service"]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "id"]
        },
        "projectId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "OPTIONS",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OTHER"
          ]
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "required": ["type", "id"]
        },
        "outcome": {
          "enum": ["success", "rejected", "failed"]
        },
        "stage": {
          "$ref": "#/$defs/ErrorBaselineStage"
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "code": {
          "type": "integer"
        },
        "metadata": {
          "type": "object"
        },
        "retentionClass": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "eventId",
        "schemaVersion",
        "requestId",
        "timestamp",
        "actor",
        "projectId",
        "operationId",
        "method",
        "resource",
        "outcome",
        "stage",
        "httpStatus",
        "code",
        "metadata",
        "retentionClass"
      ]
    },
    "SharedMockFixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtureId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "specTestId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/AuditEvent/properties/actor"
        },
        "projectId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "clock": {
          "type": "integer",
          "minimum": 0
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "GET",
                "HEAD",
                "OPTIONS",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OTHER"
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {}
          },
          "required": ["method", "headers", "body"]
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "body": {}
          },
          "required": ["status", "body"]
        },
        "expectedSideEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedAudit": {
          "$ref": "#/$defs/AuditEvent"
        },
        "redactionAssertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "fixtureId",
        "operationId",
        "specTestId",
        "actor",
        "projectId",
        "clock",
        "request",
        "response",
        "expectedSideEffects",
        "expectedAudit",
        "redactionAssertions"
      ]
    }
  },
  "$comment": "All definitions are target-reusable and not operation-bound."
}
