{
  "name": "zhihu-koc-bff",
  "version": "0.1.0",
  "private": true,
  "description": "Zhihu KOC platform backend-for-frontend",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "test": "vitest run --dir tests",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration/api.integration.spec.ts",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts tests/acceptance/scope.acceptance.ts",
    "test:db:harness": "vitest run --config vitest.testcontainers.config.ts tests/testcontainers/mysql-test-lease.spec.ts",
    "contract:inventory:generate": "tsx scripts/contracts/operation-inventory.ts generate",
    "contract:inventory:check": "tsx scripts/contracts/operation-inventory.ts check",
    "contract:registry:lint": "tsx scripts/contracts/operation-inventory.ts lint",
    "test:contract-registry": "vitest run --dir tests/unit operation-registry.spec.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/mysql": "12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "msw": "^2.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "testcontainers": "12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
