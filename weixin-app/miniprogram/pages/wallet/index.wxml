<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="row page-heading"
    ><view
      ><view class="title">收入与财务账单</view
      ></view
    ><button size="mini" disabled="{{busy || loading}}" bindtap="load"
      >刷新</button
    ></view
  >
  <template
    is="status"
    data="{{error, notice, denied, loading, scopeReady, scopeNotice, allowed, busy, guest, skeleton: true}}"
  /><skeleton wx:if="{{allowed && scopeReady && loading && !report}}" type="stats" rows="{{2}}" /><block wx:if="{{allowed && scopeReady && !error}}">
    <view class="balance-card" wx:if="{{view && view.balance}}"
      ><view class="balance-head"
        ><view
          ><view class="balance-label">可提现金额（元）</view
          ><view class="balance-value">¥{{view.balance.available}}</view></view
        ><button
          size="mini"
          data-path="/pages/withdrawals/index"
          bindtap="open"
          >去提现</button
        ></view
      ><view class="balance-sub"
        >待开放 ¥{{view.balance.held}} · 处理中 ¥{{view.balance.processing}} ·
        已到账 ¥{{view.balance.paid}} · 待抵扣 ¥{{view.balance.offset}}</view
      ></view
    >
    <view class="card"
      ><view class="row"
        ><view class="date-field"
          ><text class="field-label">开始日期</text
          ><picker
            mode="date"
            value="{{from}}"
            data-name="from"
            disabled="{{busy}}"
            bindchange="dateChange"
            >{{from}}</picker
          ></view
        ><view class="date-field"
          ><text class="field-label">结束日期</text
          ><picker
            mode="date"
            value="{{to}}"
            data-name="to"
            disabled="{{busy}}"
            bindchange="dateChange"
            >{{to}}</picker
          ></view
        ></view
      ></view
    >
    <block wx:if="{{report && !error}}">
      <view class="card"><view class="section-title">{{isStaff ? '已确认应付账单' : '个人收益'}}</view>
        <view class="stats-row"><view class="stat"><text class="stat-num">¥{{report.summary.confirmed}}</text><text class="stat-label">已确认金额</text></view><view class="stat" wx:if="{{!isStaff}}"><text class="stat-num">¥{{report.summary.pending}}</text><text class="stat-label">待确认金额</text></view></view>
        <view class="muted">拉新与拉活均已包含 · {{total}} 条明细</view>
        <button wx:if="{{!isStaff}}" size="mini" data-path="/pages/income/index" bindtap="open">按类型查看收益与计算过程</button>
        <block wx:else><view class="muted">待核对账单及整份报表在网页版财务页处理。</view><button size="mini" bindtap="web">复制网页版财务地址</button></block>
      </view>
      <view class="card"><view class="section-title">账单明细</view>
        <view wx:for="{{visibleEntries}}" wx:key="id" class="list-item">
          <view class="row"><text class="item-title">{{item.taskName}}</text><text class="amount-income">{{item.amountText}}</text></view>
          <view class="muted">{{item.businessDate}} · {{item.metricLabel}} · {{item.statusText}}</view><view class="muted" wx:if="{{isStaff}}">{{item.payeeName}}</view><view wx:if="{{item.reason}}" class="notice">{{item.reason}}</view>
          <button size="mini" data-id="{{item.id}}" bindtap="inspect">查看明细</button>
          <view wx:if="{{detail.id === item.id}}" class="notice"><view>数量：{{item.quantity === null ? '待核对' : item.quantity}}{{item.quantity === null ? '' : item.quantityUnit}}</view><view>适用单价：{{item.priceText}}</view><view>金额：{{item.amountText}}</view><block wx:if="{{!isStaff}}"><view>已确认：{{item.confirmedText}}</view><view>待确认：{{item.pendingText}}</view></block><view wx:if="{{item.nextAction}}">{{item.nextAction}}</view></view>
        </view>
        <state-view wx:if="{{!visibleEntries.length}}" text="本期没有账单，可切换日期或刷新查看。" />
      </view>
      <template is="pager" data="{{total,page,loading,busy,pageSize:25}}" />
    </block>
    <view class="card" wx:if="{{view && view.canManage}}">
      <view class="section-title">开放提现款项</view>
      <view class="item-title">本次开放 ¥{{view.funding.amount}}</view>
      <view class="muted">核对当前项目全部待开放款项。数据变化后须刷新重新核对。</view>
      <input data-name="reference" value="{{reference}}" placeholder="到账凭据或核对说明" maxlength="255" bindinput="input" />
      <checkbox-group bindchange="acknowledgeFunding"><label><checkbox value="yes" checked="{{fundingAcknowledged}}" />我已核实上述款项到账</label></checkbox-group>
      <button class="primary" disabled="{{busy || loading || !fundingAcknowledged || !reference}}" bindtap="releaseFunding">开放上述全部款项</button>
    </view>
    <button
      class="primary"
      wx:if="{{!(view && view.balance)}}"
      data-path="/pages/withdrawals/index"
      bindtap="open"
      >查看提现与审批</button
    >
  </block></view
>
