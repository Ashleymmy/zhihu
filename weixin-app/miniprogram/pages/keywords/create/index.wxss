.picker-bar {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 0;
}
.picker-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border: 1rpx solid #e0e3e1;
  border-radius: var(--radius-sm, 14rpx);
  padding: 14rpx 20rpx;
  flex: 1;
}
.picker-label { color: var(--muted, #8a9690); font-size: 24rpx; }
.picker-val { font-size: 26rpx; color: var(--forest, #214239); }

.kw-list { padding: 24rpx 32rpx 200rpx; display: flex; flex-direction: column; gap: 24rpx; }

.kw-card {
  background: #fff;
  border-radius: var(--radius, 20rpx);
  padding: 32rpx;
  position: relative;
  box-shadow: 0 1rpx 0 #e8ebe9;
}
.kw-seq { font-size: 28rpx; font-weight: 600; color: var(--forest, #214239); margin-bottom: 28rpx; }
.kw-remove {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #b0b8b4;
  line-height: 1;
}

.field-row { display: flex; align-items: center; gap: 6rpx; margin-bottom: 12rpx; }
.field-req { color: var(--clay, #d05a43); font-size: 26rpx; }
.field-label { font-size: 26rpx; color: #444; }

.kw-input {
  width: 100%;
  background: #f5f6f5;
  border-radius: var(--radius-sm, 14rpx);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: #fff;
  border-top: 1rpx solid #e8ebe9;
}
.btn-add {
  flex: 1;
  background: #f0f2f1;
  color: #214239;
  border-radius: var(--radius-sm, 14rpx);
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-sm, 14rpx);
  font-size: 28rpx;
}
