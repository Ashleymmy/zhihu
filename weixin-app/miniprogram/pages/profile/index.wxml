<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="card avatar-card" wx:if="{{user}}">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{loading || avatarBusy || editBusy || !allowed}}" aria-label="选择头像">
      <image class="profile-avatar" src="{{avatarSrc}}" mode="aspectFill" />
      <text class="avatar-hint">{{avatarBusy ? '正在保存…' : '选择头像'}}</text>
    </button>
    <text class="muted avatar-hint">由你选择头像，用于个人资料展示</text>
    <view wx:if="{{avatarError}}" class="error">{{avatarError}} <text bindtap="load">刷新</text></view>
  </view>
  <template is="status" data="{{error, loading}}" />
  <block wx:if="{{!loading && user}}">
    <view class="card cell-card">
      <view class="cell" data-text="{{user.userId}}" bindtap="copy"><text class="cell-label">用户 ID</text><text class="cell-value">{{user.userId || '—'}}</text><text wx:if="{{user.userId}}" class="cell-arrow">复制</text></view>
      <view class="cell"><text class="cell-label">登录账号</text><text class="cell-value">{{user.username}}</text></view>
      <view class="cell profile-nickname-row" bindtap="openDisplayNameModal">
        <text class="cell-label">昵称</text>
        <text class="cell-value muted">{{user.displayName || user.username}}</text>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell">
        <text class="cell-label">手机号码</text>
        <text class="cell-value muted">{{user.phone || '未填写'}}</text>
      </view>
      <view class="cell" bindtap="openPhoneVerification">
        <text class="cell-label">手机号验证</text>
        <text class="cell-value muted">{{user.phoneVerifiedAt ? '已通过短信验证' : '去验证'}}</text>
        <text class="cell-arrow" wx:if="{{!user.phoneVerifiedAt}}">›</text>
      </view>
      <view wx:if="{{!user.phoneVerifiedAt}}" class="muted" style="padding:0 28rpx 20rpx;font-size:24rpx;line-height:1.7;">可稍后验证手机号，不影响账号密码登录。验证后可使用短信验证码登录。</view>
      <view class="cell" bindtap="openContactModal">
        <text class="cell-label">备用联系方式</text>
        <text class="cell-value muted">{{user.contact || '未填写'}}</text>
        <text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="card cell-card">
      <view class="cell"><text class="cell-label">微信快捷登录（选填）</text></view>
      <view class="cell" bindtap="openSocialBinding"><text class="cell-label">微信</text><text class="cell-value muted">{{binding.bound ? (binding.currentWechat ? '已开启' : '已关联其他微信') : '未开启 · 去开启'}}</text><text class="cell-arrow" wx:if="{{binding && !binding.bound}}">›</text></view>
      <view class="muted" style="padding:20rpx 28rpx;font-size:24rpx;line-height:1.7;">{{binding.bound ? '已支持微信快捷登录。需更换微信可通过帮助与隐私联系我们。' : '验证手机号后可选择开启，与头像、昵称的选择相互独立。'}}</view>
    </view>
    <view class="card cell-card">
      <view class="cell"><text class="cell-label">邀请归属</text><text class="cell-value">{{inviteUsed ? '通过邀请加入' : '自主注册'}}</text></view>
      <view class="cell" wx:if="{{affiliation}}" data-path="/pages/join-team/index" bindtap="open"><text class="cell-label">团队</text><text class="cell-value">{{affiliation.team ? affiliation.team.leaderName : '独立达人 · 申请入团' }}</text></view>
      <view class="cell" data-path="/pages/password/index" bindtap="open">
        <text class="cell-label">{{user.hasPassword === false ? '设置登录密码' : '修改登录密码'}}</text>
        <text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-path="/pages/privacy/index" bindtap="open"><text class="cell-label">帮助与隐私 / 注销账号</text><text class="cell-arrow">›</text></view>
    </view>
  </block>

  <!-- 单项资料编辑：避开昵称选择栏和键盘 -->
  <view class="modal-mask profile-mask" wx:if="{{showEditModal}}" style="padding-bottom:{{keyboardHeight}}px" bindtap="closeEditModal">
    <view class="modal profile-modal" catchtap="noop">
      <form bindsubmit="submitEdit">
        <view class="section-head">
          <text class="section-title">{{editModalTitle}}</text>
          <view class="edit-actions">
            <button size="mini" disabled="{{editBusy}}" bindtap="closeEditModal">取消</button>
            <button size="mini" class="primary" loading="{{editBusy}}" disabled="{{editBusy}}" form-type="submit">保存</button>
          </view>
        </view>
        <view class="muted profile-modal-sub" wx:if="{{editField === 'contact'}}">微信号、QQ 等，供财务核对或紧急联系使用</view>
        <input wx:if="{{editField === 'displayName'}}" class="modal-input" name="profileValue" type="nickname" value="{{editInput}}" placeholder="选择微信昵称或自行填写" bindinput="onEditInput" bindblur="onEditInput" maxlength="64" focus="{{showEditModal}}" adjust-position="{{false}}" bindkeyboardheightchange="keyboardChange" />
        <input wx:else class="modal-input" name="profileValue" value="{{editInput}}" placeholder="如：微信号 abc123" bindinput="onEditInput" maxlength="128" focus="{{showEditModal}}" adjust-position="{{false}}" bindkeyboardheightchange="keyboardChange" />
        <view wx:if="{{editError}}" class="error">{{editError}}</view>
      </form>
    </view>
  </view>

</view>
