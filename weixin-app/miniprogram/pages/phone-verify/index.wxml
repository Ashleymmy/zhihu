<import src="../../templates/consent.wxml" />
<view class="page">
  <view class="card">
    <view class="section-title">验证手机号</view>
    <view wx:if="{{loading}}" class="muted">正在读取账号信息…</view>
    <view wx:elif="{{verified}}">
      <view class="verify-note">手机号已验证。之后可使用手机号和验证码登录平台账号。</view>
      <button class="primary" bindtap="backProfile">返回个人信息</button>
    </view>
    <view wx:elif="{{enabled}}">
      <view class="muted verify-note">使用当前账号密码和手机验证码完成验证。</view>
      <input class="verify-input" data-name="phone" value="{{phone}}" disabled="{{registeredPhone || busy || sendingCode}}" type="number" maxlength="11" placeholder="请输入手机号" bindinput="input" />
      <view wx:if="{{registeredPhone}}" class="muted verify-note">这里验证账号已登记的号码。如有误，请联系管理员修改。</view>
      <input class="verify-input" data-name="password" value="{{password}}" password placeholder="当前账号密码" bindinput="input" />
      <view class="verify-code-row"><input class="verify-input" data-name="smsCode" value="{{smsCode}}" type="number" maxlength="6" placeholder="6 位短信验证码" bindinput="input" /><button bindtap="sendCode" loading="{{sendingCode}}" disabled="{{busy || sendingCode || cooldown>0}}">{{cooldown>0?cooldown+' 秒后重发':'获取验证码'}}</button></view>
      <view class="muted verify-note">验证码 5 分钟内有效。发送时向阿里云短信服务及通信运营商提供接收手机号和验证码，仅用于本次验证。</view>
      <template is="authConsent" data="{{agreed,consentOpen}}" />
      <view wx:if="{{codeNotice}}" class="verify-note muted">{{codeNotice}}</view>
      <button class="primary {{!agreed ? 'consent-locked' : ''}}" aria-disabled="{{!agreed}}" bindtap="submit" loading="{{busy}}" disabled="{{busy || sendingCode}}">确认验证</button>
    </view>
    <view wx:else class="muted verify-note">短信验证暂未开放，请稍后再试。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
</view>
