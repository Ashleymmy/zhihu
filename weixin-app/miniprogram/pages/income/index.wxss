/* 收益页：期间快捷切换 + 收益金额语义色 */
.income-quick {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.income-quick-item {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: var(--paper-deep);
  color: var(--ink-soft);
  font-size: 26rpx;
  font-weight: 500;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.15s ease,
    opacity 0.15s ease;
}
.income-quick-active {
  background: var(--forest);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(33, 66, 57, 0.22);
}
.income-blocked {
  margin-top: 8rpx;
  font-size: 24rpx;
}
.entry-sub {
  margin-top: 6rpx;
}
