<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="row"><view class="title">我的团队</view><button size="mini" bindtap="load" disabled="{{busy || loading}}">刷新</button></view>
  <template is="status" data="{{error, notice, denied, loading, scopeReady, allowed, busy, guest}}" />
  <block wx:if="{{allowed && affiliation}}">
    <view class="card">
      <view class="title">{{affiliation.team ? affiliation.team.leaderName : '独立达人'}}</view>
      <view class="muted">{{affiliation.team ? '已加入团队，入团时自动开通团长已有项目。' : '你可以独立开展推广，也可以选择一位团长加入团队。'}}</view>
      <button size="mini" data-path="/pages/keywords/index" bindtap="open">创建 / 领取关键词</button>
    </view>
    <view class="card" wx:if="{{pending}}">
      <view>正在申请加入 {{pending.leaderName}}</view><view class="muted">等待团长确认</view>
      <button size="mini" bindtap="cancel" disabled="{{busy}}">撤回申请</button>
    </view>
    <view class="card" wx:if="{{!affiliation.team && !pending}}">
      <view class="title">申请加入团队</view>
      <input value="{{query}}" bindinput="searchLeader" placeholder="搜索团长名字或账号" maxlength="64" />
      <scroll-view scroll-y class="leader-list">
        <view wx:for="{{filteredLeaders}}" wx:key="id" class="leader {{selected.id === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="pickLeader">
          <view>{{item.displayName}}</view><view class="muted">{{item.username}} · {{item.memberCount}} 位成员 {{selected.id === item.id ? '✓' : ''}}</view>
        </view>
        <view wx:if="{{!filteredLeaders.length}}" class="muted">没有匹配的团长，可刷新后重新搜索。</view>
      </scroll-view>
      <view wx:if="{{selected}}">已选：{{selected.displayName}}</view>
      <textarea data-name="message" value="{{message}}" bindinput="input" maxlength="500" placeholder="给团长留言（选填）" auto-height />
      <button class="primary" bindtap="apply" disabled="{{!selected || busy || loading}}">提交入团申请</button>
    </view>
    <view class="card" wx:if="{{applications.length}}">
      <view class="title">申请记录</view>
      <view class="leader" wx:for="{{applications}}" wx:key="id"><view>{{item.leaderName}}</view><view class="muted">{{item.statusText}}</view></view>
    </view>
  </block>
</view>
<confirm-sheet id="confirmSheet" />
