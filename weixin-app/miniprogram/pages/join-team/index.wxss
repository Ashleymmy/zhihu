.row{justify-content:space-between}.card .title{margin-bottom:20rpx}.muted{line-height:1.7}.card button{margin-top:24rpx}.leader-list{max-height:440rpx;margin:20rpx 0}.leader{padding:20rpx;border-bottom:1rpx solid var(--line)}.chosen{background:var(--forest-tint);border-radius:12rpx;color:var(--forest)}.card input,.card textarea{box-sizing:border-box;width:100%;background:var(--paper);padding:20rpx;border-radius:var(--radius-sm);margin-top:20rpx}.card textarea{min-height:100rpx}
/* 头部位于品牌带内：标题白化 */
.team-heading { margin-bottom: 22rpx; }
.team-heading .title { margin-bottom: 0; color: #fff; }
.team-heading > button { margin: 0; flex-shrink: 0; }
