/* 登录页版式已收敛到 app.wxss（登录/注册/绑定页共用） */
.sms-input-row {display:flex; align-items:center; gap:12rpx;}
.sms-input-row input {min-width:0; flex:1;}
.sms-send {font-size:24rpx; flex-shrink:0; min-height:80rpx; line-height:80rpx; color:var(--forest); background:var(--forest-tint); padding:0 20rpx;}
.sms-help {font-size:23rpx; line-height:1.65; margin-top:18rpx;}
.sms-consent {font-size:23rpx; line-height:1.8; margin-top:20rpx; color:var(--ink-soft);}
.sms-consent checkbox {transform:scale(.7); transform-origin:left center; width:40rpx;}

.auth-mode-header {display:flex; align-items:center; justify-content:space-between; gap:12rpx; width:100%; margin:0 0 28rpx;}
.auth-mode-label {font-size:26rpx; font-weight:600; color:var(--ink);}
.auth-mode-switch {margin:0; padding:8rpx 0 8rpx 12rpx; min-height:72rpx; line-height:1.6; display:flex; align-items:center; font-size:23rpx; color:var(--forest); background:transparent; border-radius:0;}
.auth-mode-switch::after {border:0;}
.wx-consent-locked {opacity:.45; filter:grayscale(1);}
