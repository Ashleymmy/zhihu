<import src="../../templates/consent.wxml" />
<view class="login-page">
  <view class="login-logo">T</view>
  <view class="login-title">欢迎来到 TIMO</view>
  <view class="login-sub">多渠道 OPC 业务平台</view>
  <view class="auth-mode-header"><text class="auth-mode-label">{{mode==='password' ? '账号密码登录' : '短信验证码登录'}}</text><button wx:if="{{smsLoginEnabled}}" class="auth-mode-switch" bindtap="toggleMode" disabled="{{busy || sendingCode}}">{{mode==='password' ? '切换短信验证登录' : '切换账号密码登录'}} ↗</button></view>
  <view class="login-form" wx:if="{{mode==='password'}}">
    <view class="input-row"
      ><input
        data-name="username"
        value="{{username}}"
        placeholder="请输入登录账号（与网站一致）"
        placeholder-class="ph"
        bindinput="input"
    /></view>
    <view class="input-row"
      ><input
        data-name="password"
        value="{{password}}"
        password
        placeholder="请输入登录密码"
        placeholder-class="ph"
        bindinput="input"
        bindconfirm="submit"
    /></view>
  </view>
  <view class="login-form" wx:else>
    <view class="input-row"><input data-name="phone" value="{{phone}}" type="number" maxlength="11" placeholder="请输入已验证的手机号" bindinput="input" /></view>
    <view class="input-row sms-input-row"><input data-name="smsCode" value="{{smsCode}}" type="number" maxlength="6" placeholder="6 位短信验证码" bindinput="input" bindconfirm="submit" /><button class="sms-send" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{sendingCode || busy || cooldown>0}}">{{cooldown>0 ? cooldown+' 秒后重发' : '获取验证码'}}</button></view>
    <view class="muted sms-help">使用平台账号已验证的手机号登录。尚未验证的用户可先用账号密码登录，在个人信息中验证手机号。</view>
    <view class="muted sms-help">验证码 5 分钟内有效。发送时向阿里云短信服务及通信运营商提供接收手机号和验证码，仅用于本次验证。</view>
    <view class="muted sms-help" wx:if="{{codeNotice}}">{{codeNotice}}</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template is="authConsent" data="{{agreed,consentOpen}}" />
  <button
    class="primary login-btn {{!agreed ? 'consent-locked' : ''}}"
    aria-disabled="{{!agreed}}"
    loading="{{busy}}"
    disabled="{{busy || sendingCode}}"
    bindtap="submit"
    >登 录</button
  >
  <view class="login-links"
    ><text class="login-link-strong" bindtap="toRegister">注册账号</text
    ><text bindtap="forgotPassword">忘记密码</text
    ><text class="muted" bindtap="backHome">返回首页</text></view
  >
  <view class="login-divider"
    ><view class="login-divider-line"></view
    ><text>其他登录方式</text
    ><view class="login-divider-line"></view
  ></view>
  <view class="wx-entry {{!agreed ? 'wx-consent-locked' : ''}}" aria-label="微信快捷登录" hover-class="press" bindtap="wechatLogin">
    <image class="wx-icon" src="/images/channels/wechat.png" mode="aspectFit" />
  </view>
</view>
