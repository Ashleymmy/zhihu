<view class="login-page">
  <view class="login-logo">T</view>
  <view class="login-title">欢迎来到 TIMO</view>
  <view class="login-sub">多渠道 OPC 业务平台</view>
  <view class="login-modes" wx:if="{{smsLoginEnabled}}">
    <button class="mode-option {{mode==='password'?'selected':''}}" data-mode="password" bindtap="setMode" disabled="{{busy || sendingCode}}">账号密码</button>
    <button class="mode-option {{mode==='sms'?'selected':''}}" data-mode="sms" bindtap="setMode" disabled="{{busy || sendingCode}}">验证码登录</button>
  </view>
  <view class="login-form" wx:if="{{mode==='password'}}">
    <view class="input-row"
      ><input
        data-name="username"
        value="{{username}}"
        placeholder="请输入账号或手机号"
        placeholder-class="ph"
        bindinput="input"
    /></view>
    <view class="input-row"
      ><input
        data-name="password"
        value="{{password}}"
        password
        placeholder="请输入登录密码"
        placeholder-class="ph"
        bindinput="input"
        bindconfirm="submit"
    /></view>
  </view>
  <view class="login-form" wx:else>
    <view class="input-row"><input data-name="phone" value="{{phone}}" type="number" maxlength="11" placeholder="请输入已验证的手机号" bindinput="input" /></view>
    <view class="input-row sms-input-row"><input data-name="smsCode" value="{{smsCode}}" type="number" maxlength="6" placeholder="6 位短信验证码" bindinput="input" bindconfirm="submit" /><button class="sms-send" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{sendingCode || busy || cooldown>0}}">{{cooldown>0 ? cooldown+' 秒后重发' : '获取验证码'}}</button></view>
    <view class="muted sms-help">仅支持已验证手机号且绑定当前微信的账号。首次使用请通过账号密码登录，在个人信息中验证手机号。</view>
    <view class="muted sms-help">验证码 5 分钟内有效。发送时向阿里云短信服务及通信运营商提供接收手机号和验证码，仅用于本次验证。</view>
    <view class="sms-consent" bindtap="toggleAgree"><checkbox checked="{{agreed}}" color="#214e43" />我已阅读并同意<text class="agreement-link" data-type="user" catchtap="openAgreement">《用户协议》</text>与<text class="agreement-link" data-type="privacy" catchtap="openAgreement">《隐私协议》</text></view>
    <view class="muted sms-help" wx:if="{{codeNotice}}">{{codeNotice}}</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button
    class="primary login-btn"
    loading="{{busy}}"
    disabled="{{busy || sendingCode}}"
    bindtap="submit"
    >登 录</button
  >
  <view class="login-links"
    ><text class="login-link-strong" bindtap="toRegister">注册账号</text
    ><text bindtap="forgotPassword">忘记密码</text
    ><text class="muted" bindtap="backHome">返回首页</text></view
  >
  <view class="login-divider"
    ><view class="login-divider-line"></view
    ><text>其他登录方式</text
    ><view class="login-divider-line"></view
  ></view>
  <view class="wx-entry" hover-class="press" bindtap="wechatLogin">
    <image class="wx-icon" src="/images/channels/wechat.png" mode="aspectFit" />
  </view>
  <view class="login-agreement" wx:if="{{mode==='password'}}">登录即代表您知晓并同意<text class="agreement-link" data-type="user" bindtap="openAgreement">《用户协议》</text>与<text class="agreement-link" data-type="privacy" bindtap="openAgreement">《隐私协议》</text></view>
</view>
