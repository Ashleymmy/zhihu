<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="row page-heading">
    <view>
      <view class="title">学院</view>
      <text class="muted">从入门到卓越的系统课程</text>
    </view>
    <button size="mini" disabled="{{busy || loading}}" bindtap="load">刷新</button>
  </view>
  <template
    is="status"
    data="{{error, notice, denied, loading, scopeReady, scopeNotice, allowed, busy, guest, skeleton: true}}"
  />
  <skeleton wx:if="{{allowed && loading && !tiers.length}}" rows="{{3}}" />
  <block wx:if="{{allowed}}">
    <view
      class="card rise"
      wx:for="{{tiers}}"
      wx:key="key"
      wx:for-item="tier"
    >
      <view class="row">
        <view class="section-title">{{tier.title}}</view>
        <text class="tag {{tier.key === 'gold' ? 'tag-sun' : tier.key === 'elite' ? 'tag-clay' : 'tag-moss'}}">{{tier.courses.length}} 门</text>
      </view>
      <view class="muted tier-sub">{{tier.subtitle}}</view>
      <view
        class="course"
        wx:for="{{tier.courses}}"
        wx:for-item="course"
        wx:key="id"
        data-id="{{course.id}}"
        hover-class="press"
        bindtap="openCourse"
      >
        <image
          class="course-cover"
          src="{{course.coverSrc}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="course-main">
          <view class="item-title">{{course.title}}</view>
          <view class="muted clamp2">{{course.intro}}</view>
          <view class="muted course-meta">{{course.duration}} · {{course.views}} 人学过</view>
        </view>
      </view>
      <state-view wx:if="{{!tier.courses.length}}" text="课程筹备中，敬请期待。" />
    </view>
  </block>

  <!-- 课程详情：iOS 半屏弹层 -->
  <view wx:if="{{detail}}" class="modal-mask">
    <scroll-view scroll-y class="modal">
      <view class="row">
        <view class="section-title">{{detail.title}}</view>
        <button size="mini" bindtap="closeDetail">关闭</button>
      </view>
      <image class="detail-cover" src="{{detail.cover || covers[detail.tier]}}" mode="aspectFill" />
      <view class="muted detail-meta">{{detail.duration}} · {{detail.views}} 人学过</view>
      <view class="detail-intro">{{detail.intro}}</view>
      <view class="detail-section" wx:for="{{detail.sections}}" wx:key="title">
        <view class="detail-section-title">{{index + 1}}. {{item.title}}</view>
        <view class="detail-section-body">{{item.content}}</view>
      </view>
      <view wx:if="{{!detail.sections.length}}" class="muted">课程详情整理中。</view>
    </scroll-view>
  </view>
</view>
