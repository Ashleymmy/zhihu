/* 我的页：资料头 + 单元格列表（基础样式在 app.wxss） */
.profile-info {
  flex: 1;
  min-width: 0;
}
.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
@import "../../templates/member-summary.wxss";

.user-id { font-size: 24rpx; word-break: break-all; margin-top: 10rpx; }
/* 品牌带内资料头白化；复制入口用品牌金提示可点 */
.id-copy { font-size: 22rpx; margin-left: 10rpx; color: #ffe9ad; }
.profile-head .profile-name { color: #fff; }
.profile-head .muted { color: rgba(255, 255, 255, 0.72); }
