/* 我的页：资料头 + 单元格列表（基础样式在 app.wxss） */
.profile-info {
  flex: 1;
  min-width: 0;
}
.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
@import "../../templates/member-summary.wxss";

.user-id { font-size: 24rpx; word-break: break-all; margin-top: 10rpx; }
.id-copy { font-size: 22rpx; margin-left: 10rpx; color: var(--brand); }
