<view class="login-page">
  <view class="login-title">注册账号</view>
  <view class="login-sub">{{smsRequired ? '验证手机号后注册，邀请码决定团队归属' : '手机号 + 密码注册，邀请码决定团队归属'}}</view>
  <view class="login-form">
    <view class="input-row"
      ><input
        type="number"
        data-name="phone"
        value="{{phone}}"
        maxlength="11"
        disabled="{{sendingCode || busy}}"
        placeholder="请输入手机号"
        placeholder-class="ph"
        bindinput="input"
    /></view>
    <view wx:if="{{smsRequired}}" class="input-row sms-row">
      <input type="number" data-name="smsCode" value="{{smsCode}}" maxlength="6" placeholder="6 位短信验证码" placeholder-class="ph" bindinput="input" />
      <button class="sms-send" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{sendingCode || busy || cooldown > 0 || !policyReady}}">{{cooldown > 0 ? cooldown + '秒后重试' : '获取验证码'}}</button>
    </view>
    <view class="input-row"
      ><input
        data-name="password"
        value="{{password}}"
        password
        placeholder="请设置登录密码（至少 8 位）"
        placeholder-class="ph"
        bindinput="input"
    /></view>
    <view class="input-row"
      ><input
        data-name="inviteCode"
        value="{{inviteCode}}"
        placeholder="请输入邀请码（必填）"
        placeholder-class="ph"
        bindinput="input"
    /></view>
    <view class="input-row"
      ><input
        data-name="displayName"
        value="{{displayName}}"
        maxlength="32"
        placeholder="昵称（选填）"
        placeholder-class="ph"
        bindinput="input"
    /></view>
  </view>
  <view wx:if="{{codeNotice}}" class="form-hint">{{codeNotice}}</view>
  <view wx:if="{{smsRequired && !codeNotice}}" class="form-hint">请先填写邀请码并同意协议，再获取验证码。</view>
  <view wx:if="{{!policyReady}}" class="form-hint">
    {{policyLoading ? '正在读取注册规则…' : '注册规则读取失败'}}
    <text wx:if="{{!policyLoading}}" class="agreement-link" bindtap="loadPolicy">重试</text>
  </view>
  <view class="form-hint">注册成功后系统自动分配账号 ID，并按邀请码加入对应团队。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="agree-row">
    <view class="agree-check {{agreed ? 'agree-on' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</view>
    <text class="agree-text">已阅读并同意<text class="agreement-link" data-type="user" bindtap="openAgreement">《用户协议》</text>与<text class="agreement-link" data-type="privacy" bindtap="openAgreement">《隐私协议》</text></text>
  </view>
  <button
    class="primary login-btn"
    loading="{{busy}}"
    disabled="{{busy || sendingCode || !policyReady}}"
    bindtap="submit"
    >注册并登录</button
  >
  <view class="login-links"
    ><text class="login-link-strong" bindtap="toLogin">已有账号？去登录</text
    ><text class="muted" bindtap="backHome">返回首页</text></view
  >
  <confirm-sheet id="confirmSheet" />
</view>
