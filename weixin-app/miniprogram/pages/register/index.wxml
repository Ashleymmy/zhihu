<import src="../../templates/consent.wxml" />
<view class="login-page">
  <view class="login-title">注册账号</view>
  <view class="login-sub">{{inviteCode ? '邀请信息已自动携带，验证手机号后完成注册' : '验证手机号，注册为独立达人'}}</view>
  <view class="login-form">
    <view class="input-row"><input type="number" data-name="phone" value="{{phone}}" maxlength="11" disabled="{{sendingCode || busy}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="input" /></view>
    <view class="input-row sms-row">
      <input type="number" data-name="smsCode" value="{{smsCode}}" maxlength="6" placeholder="6 位短信验证码" placeholder-class="ph" bindinput="input" />
      <button class="sms-send" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{sendingCode || busy || cooldown>0 || !policyReady}}">{{cooldown>0 ? cooldown+' 秒后重发' : '获取验证码'}}</button>
    </view>
    <view class="input-row"><input data-name="password" value="{{password}}" password placeholder="设置登录密码（至少 8 位）" placeholder-class="ph" bindinput="input" /></view>
    <view class="input-row"><input data-name="displayName" value="{{displayName}}" maxlength="32" placeholder="昵称（选填）" placeholder-class="ph" bindinput="input" /></view>
  </view>
  <view wx:if="{{codeNotice}}" class="form-hint">{{codeNotice}}</view>
  <view class="form-hint">验证码 5 分钟内有效。发送时向阿里云短信服务及通信运营商提供接收手机号和验证码，仅用于本次验证。</view>
  <view wx:if="{{!policyReady}}" class="form-hint">{{policyLoading ? '正在读取注册规则…' : '注册暂不可用'}} <text wx:if="{{!policyLoading}}" class="agreement-link" bindtap="loadPolicy">重试</text></view>
  <view class="form-hint">注册后可在“个人信息 → 社交账号绑定”中主动绑定微信，开启微信快捷登录。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template is="authConsent" data="{{agreed,consentOpen}}" />
  <button class="primary login-btn {{!agreed ? 'consent-locked' : ''}}" aria-disabled="{{!agreed}}" loading="{{busy}}" disabled="{{busy || sendingCode}}" bindtap="submit">注册并登录</button>
  <view class="login-links"><text class="login-link-strong" bindtap="toLogin">已有账号？去登录</text><text class="muted" bindtap="backHome">返回首页</text></view>
</view>
