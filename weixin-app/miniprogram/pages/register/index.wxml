<import src="../../templates/consent.wxml" />
<view class="login-page">
  <view class="login-title">注册账号</view>
  <view class="login-sub">{{inviteCode ? '邀请信息已自动携带，注册后加入对应归属' : '创建账号，注册为独立达人'}}</view>
  <view class="login-form">
    <view class="input-row"><input data-name="username" value="{{username}}" maxlength="32" disabled="{{busy}}" placeholder="设置登录账号（字母开头，3–32 位）" placeholder-class="ph" bindinput="input" /></view>
    <view class="input-row"><input data-name="password" value="{{password}}" password maxlength="72" disabled="{{busy}}" placeholder="设置登录密码（至少 8 位）" placeholder-class="ph" bindinput="input" /></view>
    <view class="input-row"><input data-name="displayName" value="{{displayName}}" maxlength="32" disabled="{{busy}}" placeholder="昵称（选填）" placeholder-class="ph" bindinput="input" /></view>
  </view>
  <view class="form-hint">注册后即可使用，同一账号密码可登录网站和小程序。请记住你的登录账号。</view>
  <view class="form-hint">手机号可稍后前往“我的 → 个人信息 → 手机号验证”中验证；微信快捷登录也可在个人信息中主动绑定后开启。</view>
  <view wx:if="{{!policyReady}}" class="form-hint">{{policyLoading ? '正在读取注册规则…' : '注册暂不可用'}} <text wx:if="{{!policyLoading}}" class="agreement-link" bindtap="loadPolicy">重试</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template is="authConsent" data="{{agreed,consentOpen}}" />
  <button class="primary login-btn {{!agreed ? 'consent-locked' : ''}}" aria-disabled="{{!agreed}}" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">注册并登录</button>
  <view class="login-links"><text class="login-link-strong" bindtap="toLogin">已有账号？去登录</text><text class="muted" bindtap="backHome">返回首页</text></view>
</view>
