<import src="../../templates/consent.wxml" />
<view class="login-page">
  <view class="login-title">注册账号</view>
  <view class="login-sub">{{inviteCode ? '邀请信息已自动携带，注册后加入对应归属' : '创建账号，注册为独立达人'}}</view>
  <view class="login-form">
    <view class="input-row"><input data-name="phone" value="{{phone}}" type="number" maxlength="11" disabled="{{busy || sendingCode}}" placeholder="请输入手机号" placeholder-class="ph" bindinput="input" /></view>
    <view class="input-row sms-row"><input data-name="smsCode" value="{{smsCode}}" type="number" maxlength="6" disabled="{{busy}}" placeholder="6 位短信验证码" placeholder-class="ph" bindinput="input" /><button class="sms-button" bindtap="sendCode" loading="{{sendingCode}}" disabled="{{busy || sendingCode || cooldown > 0 || !policyReady}}">{{cooldown > 0 ? cooldown + ' 秒后重发' : '获取验证码'}}</button></view>
    <view class="input-row"><input data-name="displayName" value="{{displayName}}" maxlength="32" disabled="{{busy}}" placeholder="昵称（选填）" placeholder-class="ph" bindinput="input" /></view>
  </view>
  <view class="form-hint">手机号验证后即可注册并登录，系统自动分配用户 ID。登录密码、微信快捷登录和头像可稍后设置。</view>
  <view class="form-hint">验证码仅用于验证手机号，由阿里云短信服务及通信运营商发送。</view>
  <view wx:if="{{codeNotice}}" class="form-hint">{{codeNotice}}</view>
  <view wx:if="{{!policyReady}}" class="form-hint">{{policyLoading ? '正在读取注册规则…' : '注册暂不可用'}} <text wx:if="{{!policyLoading}}" class="agreement-link" bindtap="loadPolicy">重试</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <template is="authConsent" data="{{agreed,consentOpen}}" />
  <button class="primary login-btn {{!agreed ? 'consent-locked' : ''}}" aria-disabled="{{!agreed}}" loading="{{busy}}" disabled="{{busy || sendingCode || !policyReady}}" bindtap="submit">注册并登录</button>
  <view class="login-links"><text class="login-link-strong" bindtap="toLogin">已有账号？去登录</text><text class="muted" bindtap="backHome">返回首页</text></view>
</view>
