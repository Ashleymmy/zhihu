.report-page > .title { color: #fff; }
.report-intro { margin: 14rpx 0 30rpx; color: #d3dfd8; font-size: 25rpx; line-height: 1.7; }
.report-tabs { display: flex; gap: 12rpx; padding: 10rpx; margin: 0 0 24rpx; background: #e6ece7; border-radius: 20rpx; }
.report-tabs button { flex: 1; margin: 0; background: transparent; color: #7b8a80; line-height: 74rpx; font-size: 27rpx; }
.report-tabs button::after { border: 0; }
.report-tabs .active { background: #fff; color: #234536; box-shadow: 0 3rpx 9rpx rgba(32, 61, 45, .06); }
.work-search { display: flex; align-items: center; gap: 14rpx; margin-bottom: 20rpx; }
.work-search input { flex: 1; min-width: 0; margin: 0; }
.work-search button { flex: none; margin: 0; }
.work-picker { display: flex; justify-content: space-between; gap: 16rpx; padding: 22rpx; margin: 14rpx 0; border: 1rpx solid #dce5de; border-radius: 14rpx; color: #3b5947; line-height: 1.7; font-size: 26rpx; }
.work-picker text { flex: none; }
.type-choices { display: flex; gap: 18rpx; margin-bottom: 28rpx; }
.type-choices button { flex: 1; margin: 0; color: #64766a; background: #f3f5f2; font-size: 27rpx; }
.type-choices .chosen { color: #234c38; background: #e6f0e8; }
.type-choices .chosen::after { border-color: #7d9d88; }
.field-label { margin: 28rpx 0 14rpx; font-size: 27rpx; }
.image-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.image-item { position: relative; width: 170rpx; height: 190rpx; border-radius: 14rpx; overflow: hidden; background: #f1f4ef; }
.image-item image { width: 170rpx; height: 190rpx; }
.image-item .remove-image { position: absolute; bottom: 0; left: 0; width: 100%; margin: 0; border-radius: 0; background: rgba(25, 45, 33, .75); color: #fff; font-size: 22rpx; }
.add-image { display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0; width: 170rpx; height: 190rpx; color: #7b9183; font-size: 48rpx; line-height: 1.5; background: #f3f6f1; }
.add-image view { font-size: 24rpx; }
.screenshot-tip { margin-top: 18rpx; font-size: 23rpx; line-height: 1.7; }
.submit-report { margin: 26rpx 0; }
.record-keyword { min-width: 0; flex: 1; font-size: 31rpx; font-weight: 600; line-height: 1.5; overflow-wrap: break-word; }
.record-status { margin: 22rpx 0 12rpx; color: #3d6d4f; font-size: 27rpx; font-weight: 500; }
.needs-check { color: #ae6e2f; }
.record-message { font-size: 24rpx; line-height: 1.8; }
.record-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.record-actions button { margin: 0; }
.risk-result { margin-top: 22rpx; padding: 22rpx; border-radius: 16rpx; background: #f2f6f1; line-height: 1.8; font-size: 25rpx; }
.result-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14rpx; margin-top: 12rpx; }
.small-pager { gap: 18rpx; margin-top: 24rpx; }
.small-pager button { margin: 0; }
