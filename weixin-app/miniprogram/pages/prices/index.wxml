<import src="../../templates/shared.wxml" />
<view class="page"><role-nav user="{{user}}" active="prices" />
 <view class="row page-heading"><view class="title">{{isStaff ? '定价规则' : '我的适用单价'}}</view><button size="mini" disabled="{{loading}}" bindtap="load">刷新</button></view>
 <template is="status" data="{{error,notice,denied,loading,scopeReady,scopeNotice,allowed,busy,guest}}" />
 <block wx:if="{{allowed && scopeReady && !error}}">
  <block wx:if="{{isStaff}}">
   <view class="card"><view class="muted">查看拉新、拉活的有效规则与生效日期。发布新单价在网页版完成。</view><button size="mini" bindtap="web">复制网页版定价地址</button></view>
   <view class="card" wx:for="{{metrics}}" wx:key="code"><view class="section-title">{{item.label}} · 元/{{item.unit}}</view><view class="list-item" wx:for="{{item.versions}}" wx:for-item="rule" wx:key="id"><view class="row"><text>{{rule.ruleLabel}}</text><text class="tag">{{rule.state}}</text></view><view class="item-title">¥{{rule.unitPrice}}</view><view class="muted">{{rule.effectiveFrom}} 起，{{rule.effectiveTo ? rule.effectiveTo+' 前有效' : '长期有效'}}</view></view><view wx:if="{{!item.versions.length}}" class="muted">尚未设置，请在网页版完善单价。</view></view>
  </block>
  <block wx:else>
   <view class="card"><view class="muted">按你的关键词展示当前适用单价；已有收益以当日实际单价为准。</view><input data-name="search" value="{{search}}" placeholder="搜索关键词" bindinput="input" bindconfirm="search" /><button size="mini" bindtap="search">搜索</button></view>
   <view class="card" wx:for="{{list}}" wx:key="id"><view class="section-title">{{item.title}}</view><view class="row" wx:for="{{item.prices}}" wx:for-item="price" wx:key="label"><text>{{price.label}}</text><text>{{price.value}}</text></view><view wx:if="{{!item.prices.length}}" class="muted">此记录暂无适用单价。</view></view>
   <view class="card" wx:if="{{!loading && !list.length}}"><view class="muted">没有匹配的关键词，可先创建或领取。</view><button size="mini" bindtap="keywords">查看我的关键词</button></view>
   <template is="pager" data="{{total,page,loading,busy,pageSize:20}}" />
  </block>
 </block>
</view>
