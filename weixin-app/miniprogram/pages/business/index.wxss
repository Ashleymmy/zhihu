.business-page{padding-bottom:64rpx}.business-intro{padding:16rpx 8rpx 36rpx}.intro-copy{color:rgba(255,255,255,.8);font-size:28rpx;margin-top:16rpx}.contact-card{padding:44rpx 32rpx 32rpx;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 40rpx rgba(22,55,46,.08);text-align:center}.contact-heading{font-size:24rpx;color:var(--ink-soft);letter-spacing:2rpx}.contact-name{font-size:40rpx;font-weight:700;margin-top:20rpx;word-break:break-all}.hours{margin-top:12rpx;font-size:24rpx}.contact-tabs{display:flex;gap:8rpx;margin:28rpx auto 0;max-width:420rpx;padding:8rpx;border-radius:18rpx;background:var(--paper-deep)}.contact-tab{flex:1;min-width:0;margin:0;border-radius:14rpx;background:transparent;font-size:28rpx;line-height:2.4;color:var(--ink-soft);padding:0}.contact-tab::after{border:0}.contact-tab.active{background:var(--forest);color:#fff}.qr-frame{width:480rpx;max-width:100%;height:480rpx;box-sizing:border-box;padding:20rpx;border:1rpx solid var(--line);border-radius:20rpx;margin:28rpx auto;background:#fff}.qr-image{display:block;width:100%;height:100%}.qr-failed{height:400rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24rpx;color:var(--ink-soft);font-size:26rpx}.scan-hint{font-size:28rpx;margin:20rpx 0 28rpx}.save-qr{width:100%;border-radius:18rpx}.preview-hint{font-size:24rpx;line-height:1.7;margin-top:20rpx}.link-contact,.empty-contact{margin-top:28rpx}.link-contact .muted,.empty-contact .muted{margin:16rpx 0 24rpx;line-height:1.7}

.business-intro .title{color:var(--white)}
