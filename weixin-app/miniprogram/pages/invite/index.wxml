<import src="../../templates/shared.wxml" />
<view class="page">
  <view class="row page-heading"><view class="title">邀请好友</view><button size="mini" disabled="{{busy || loading}}" bindtap="load">刷新</button></view>
  <template is="status" data="{{error,notice,denied,loading,scopeReady,scopeNotice,allowed,busy,guest,skeleton:true}}" />
  <block wx:if="{{allowed && scopeReady && code}}">
    <view class="invite-card rise">
      <view class="invite-label">一起加入 TIMO</view>
      <view class="invite-sub">通过下方卡片邀请好友，注册时会自动携带邀请信息，无需填写邀请码。团长邀请的达人会自动加入对应团队。</view>
      <view class="invite-actions"><button class="invite-btn invite-btn-primary" open-type="share" disabled="{{loading || busy}}">分享给微信好友</button></view>
    </view>
    <view class="card stats-row"><view class="stat"><text class="stat-num">{{usageCount}}</text><text class="stat-label">成功邀请（人）</text></view></view>
    <view class="card"><view class="section-title">邀请记录</view>
      <view class="list-item" wx:for="{{records}}" wx:key="id"><view class="row"><view class="item-title">{{item.name}}</view><text class="muted">已注册</text></view><view class="muted">{{item.timeText}}</view></view>
      <state-view wx:if="{{!records.length}}" text="暂无邀请记录，分享卡片给好友开始邀请吧。" />
    </view>
  </block>
</view>
