/* 邀请页展示与好友收到的卡片一致的品牌封面。邀请记录仅供本人查看。 */
.invite-card {
  background: linear-gradient(135deg, #17352e 0%, #214239 55%, #2f6b52 100%);
  border-radius: var(--radius);
  padding: 0 0 30rpx;
  margin-bottom: 22rpx;
  color: #fff;
  text-align: center;
  overflow: hidden;
}
.invite-cover {
  display: block;
  width: 100%;
}
.invite-actions {
  display: flex;
  gap: 20rpx;
  margin: 0 30rpx;
}
.invite-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  padding: 0 8rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
}
.invite-btn::after {
  border: 0;
}
.invite-btn-primary {
  background: #fff;
  color: var(--forest);
}
/* 海报：离屏画布 + 预览弹层 */
.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 375px;
  height: 590px;
}
.poster-modal {
  height: auto;
  max-height: 86vh;
}
.poster-preview {
  width: 100%;
  max-height: 56vh;
  object-fit: contain;
  border-radius: 16rpx;
  background: var(--paper-deep);
}
.poster-tip {
  margin: 16rpx 0 8rpx;
  text-align: center;
}
