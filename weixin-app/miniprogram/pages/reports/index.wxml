<import src="../../templates/shared.wxml" />
<view class="page"><role-nav user="{{user}}" active="reports" />
 <view class="row page-heading"><view class="title">报表与异常</view><button size="mini" disabled="{{busy || loading}}" bindtap="load">刷新</button></view>
 <template is="status" data="{{error,notice,denied,loading,scopeReady,scopeNotice,allowed,busy,guest}}" />
 <block wx:if="{{allowed && scopeReady && !error}}">
  <view class="wrap actions"><button size="mini" data-section="imports" bindtap="section">报表记录</button><button size="mini" data-section="exceptions" bindtap="section">需要跟进</button></view>
  <view class="card"><view class="section-title">上传与核对报表</view><view class="muted">本页查看进度，完整报表及异常在网页版财务页处理。</view><button class="primary" bindtap="web">复制网页版处理地址</button></view>
  <view class="wrap actions" wx:if="{{section === 'exceptions'}}"><button size="mini" data-view="open" bindtap="issueView">需要跟进</button><button size="mini" data-view="done" bindtap="issueView">已处理</button><button size="mini" data-view="all" bindtap="issueView">全部</button></view>
  <view wx:for="{{list}}" wx:key="id" class="card">
   <block wx:if="{{section === 'imports'}}"><view class="row"><view class="item-title">{{item.fileName}}</view><text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.typeText}} · {{item.createdAt}}</view><button size="mini" data-id="{{item.id}}" bindtap="inspect">查看处理进度</button>
    <view wx:if="{{detail.id === item.id}}"><view wx:for="{{detail.steps}}" wx:for-item="step" wx:key="key" class="report-row"><view>{{step.title}}</view><view class="muted">{{step.summary}}</view></view><view class="notice">{{detail.conclusion.title}} {{detail.conclusion.value}}<view>{{detail.conclusion.summary}}</view></view><button size="mini" bindtap="web">复制地址继续处理</button></view>
   </block>
   <block wx:else><view class="item-title">{{item.keyword || item.reason}}</view><view class="tag">{{item.statusText}}</view><view>{{item.reason}}</view><view class="notice">{{item.next}}</view><button wx:if="{{item.status === 'open'}}" size="mini" bindtap="web">复制网页版跟进地址</button></block>
  </view>
  <state-view wx:if="{{!loading && !list.length}}" text="当前没有记录，可刷新或切换查看范围。" />
  <template is="pager" data="{{total,page,loading,busy,pageSize:20}}" />
 </block>
</view>
