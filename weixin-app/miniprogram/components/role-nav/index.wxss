/* 角色导航：横向滚动胶囊条，白底轻投影，选中品牌绿实底 */
.nav-wrap {
  margin-bottom: 24rpx;
  white-space: nowrap;
  width: 100%;
}
.nav-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx 8rpx;
}
.nav-pill {
  flex-shrink: 0;
  display: inline-block;
  margin: 0;
  padding: 14rpx 32rpx;
  font-size: 25rpx;
  line-height: 1.5;
  border: 0;
  border-radius: 999rpx;
  color: var(--ink-soft, #7c8883);
  background: var(--white, #ffffff);
  box-shadow: 0 2rpx 8rpx rgba(29, 39, 35, 0.05);
}
.nav-pill::after {
  border: 0;
}
.nav-pill.active {
  color: #fff;
  background: var(--forest, #214239);
  font-weight: 600;
  box-shadow: 0 6rpx 14rpx rgba(33, 66, 57, 0.24);
}
